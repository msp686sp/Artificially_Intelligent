<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Rental Backtest Report</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
           max-width: 1000px; margin: 24px auto; padding: 0 16px; color: #222; }
    h1 { margin-bottom: 4px; }
    h2 { margin-top: 32px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
    table { border-collapse: collapse; width: 100%; margin: 8px 0 24px; }
    th, td { border: 1px solid #ddd; padding: 6px 10px; text-align: right;
             font-variant-numeric: tabular-nums; font-size: 13px; }
    th { background: #f6f6f6; }
    td.l, th.l { text-align: left; }
    .banner-not-ready {
      background: #b32d2d; color: white; padding: 16px 20px; border-radius: 6px;
      font-size: 20px; font-weight: 600; margin: 20px 0;
    }
    .banner-ready {
      background: #2d8b3a; color: white; padding: 12px 18px; border-radius: 6px;
      font-size: 16px; font-weight: 500; margin: 20px 0;
    }
    .meta { color: #666; font-size: 13px; }
    .pos { color: #1d6f2a; } .neg { color: #b32d2d; }
    .small { font-size: 12px; color: #666; }
    .weights { font-family: monospace; font-size: 13px; }
  </style>
</head>
<body>
  <h1>Rental Backtest Report</h1>
  <div class="meta">Generated {{ ctx.generated_at }}.
    Primary target: 5-year levered total return (cash-on-cash + appreciation).</div>

  {% if ctx.ready %}
    <div class="banner-ready">
      READY: top quintile beats bottom with significance on a majority of snapshots
      (mean top-bottom = {{ ctx.overall_mean_top_minus_bottom | fmt(3) }}).
    </div>
  {% else %}
    <div class="banner-not-ready">
      NOT READY — the scorecard does not separate top from bottom with statistical
      significance. Iterate on features and weights before shipping.
    </div>
  {% endif %}

  <h2>Headline</h2>
  <table>
    <tr><th class="l">Snapshots</th><td>{{ ctx.snapshots | length }}</td></tr>
    <tr><th class="l">Mean Spearman (score, realized)</th>
        <td>{{ ctx.overall_mean_spearman | fmt(4) }}</td></tr>
    <tr><th class="l">Mean top-quintile − bottom-quintile</th>
        <td>{{ ctx.overall_mean_top_minus_bottom | fmt(4) }}</td></tr>
  </table>

  {% if ctx.tune %}
    <h2>Walk-forward tuning</h2>
    <table>
      <tr><th class="l">Grid points searched</th><td>{{ ctx.tune.grid_size }}</td></tr>
      <tr><th class="l">Best in-sample mean Spearman</th>
          <td>{{ ctx.tune.train_mean_spearman | fmt(4) }}</td></tr>
      <tr><th class="l">Out-of-sample mean Spearman</th>
          <td>{{ ctx.tune.validate_mean_spearman | fmt(4) }}</td></tr>
    </table>
    <p class="weights">Recommended weights:
      {% for k, v in ctx.tune.best_weights.items() %}
        {{ k }}={{ "%.3f"|format(v) }}{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
  {% endif %}

  <h2>Per-snapshot results</h2>
  <table>
    <thead>
      <tr>
        <th class="l">Snapshot</th>
        <th>N zips</th>
        <th>Spearman</th>
        <th>Top − Bottom</th>
        <th>Bootstrap CI</th>
        <th>Quintile means</th>
        <th>Quintile chart</th>
      </tr>
    </thead>
    <tbody>
      {% for s in ctx.snapshots %}
      <tr>
        <td class="l">{{ s.snapshot_date }}</td>
        <td>{{ s.n_zips }}</td>
        <td class="{% if s.spearman > 0 %}pos{% else %}neg{% endif %}">
          {{ s.spearman | fmt(4) }}
        </td>
        <td class="{% if s.top_minus_bottom > 0 %}pos{% else %}neg{% endif %}">
          {{ s.top_minus_bottom | fmt(4) }}
        </td>
        <td>
          [{{ s.ci_low | fmt(3) }}, {{ s.ci_high | fmt(3) }}]
          {% if s.significant %}<span class="pos">*</span>{% endif %}
        </td>
        <td class="small">
          {% for q in s.quintile_means %}{{ q | fmt(3) }}{% if not loop.last %} / {% endif %}{% endfor %}
        </td>
        <td>{{ s.quintile_svg | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Baselines (Spearman vs. realized)</h2>
  <table>
    <thead>
      <tr>
        <th class="l">Snapshot</th>
        <th>MarketScore</th>
        <th>Yield-only</th>
        <th>Equal-weighted</th>
        <th>Random</th>
      </tr>
    </thead>
    <tbody>
      {% for s in ctx.snapshots %}
      <tr>
        <td class="l">{{ s.snapshot_date }}</td>
        <td>{{ s.spearman | fmt(4) }}</td>
        <td>{{ s.baselines.yield_only_spearman | fmt(4) }}</td>
        <td>{{ s.baselines.equal_weighted_spearman | fmt(4) }}</td>
        <td>{{ s.baselines.random_spearman | fmt(4) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p class="small">Statistical significance marker (<span class="pos">*</span>) means
    the 95% bootstrap CI on top-bottom quintile difference excludes zero.</p>
</body>
</html>
